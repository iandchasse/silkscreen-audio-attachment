	(gr_text "SILKSCREEN AUDIO ATTACHMENT rev A"
		(at 129.5 103.2 0)
		(layer "B.SilkS")
		(uuid "ef288599-afc6-50bc-83db-a6771d49029e")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
			(justify mirror)
		)
	)
	(gr_text "Header pads are named by the mating J6 pin: J1 1 GND, 2 BCLK, 3 DOUT, 4 GND; J2 9 WS; J3 12 VBAT. No pad or hole at J6 5-8, 10, 11."
		(at 96 114.8 0)
		(layer "Cmts.User")
		(uuid "3112be20-b067-5b46-ae1e-cdd57b6f24b9")
		(effects
			(font
				(size 0.9 0.9)
				(thickness 0.15)
			)
			(justify left)
		)
	)
	(gr_text "All SMD parts on the top side (F.Cu). J1 (1x4), J2 and J3 (1x1) THT headers are NOT assembled: hand-soldered from the underside."
		(at 96 113.2 0)
		(layer "Cmts.User")
		(uuid "57a5b9c0-3fe2-56b7-bc95-98dacfe42e0a")
		(effects
			(font
				(size 0.9 0.9)
				(thickness 0.15)
			)
			(justify left)
		)
	)
	(gr_text "4 NPTH: 2 x 4.80 lid screw columns, 2 x 1.30 jack pegs. GND pours on both layers."
		(at 96 116.4 0)
		(layer "Cmts.User")
		(uuid "6c715b99-26ad-5073-a066-14fa9d7ced1d")
		(effects
			(font
				(size 0.9 0.9)
				(thickness 0.15)
			)
			(justify left)
		)
	)
	(gr_text "FR-4 1.0 mm, 1 oz, any solder mask colour (black preferred), white silk, LF-HASL or ENIG. No order numbers."
		(at 96 111.6 0)
		(layer "Cmts.User")
		(uuid "88de7d38-1609-5a19-8e79-5bde2f1b2891")
		(effects
			(font
				(size 0.9 0.9)
				(thickness 0.15)
			)
			(justify left)
		)
	)
	(gr_text "SILKSCREEN AUDIO ATTACHMENT rev A - FAB NOTES (JLCPCB standard 2-layer)"
